#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")" && pwd)"

usage() {
  cat <<EOF
Usage:
  insightforge web                         Start the InsightForge Web development server
  insightforge web start                   Serve a built InsightForge Web app
EOF
}

if [[ $# -lt 1 ]]; then
  usage
  exit 2
fi

command="$1"
shift

case "$command" in
  web)
    web_mode="${1:-dev}"
    if [[ "$web_mode" == "start" ]]; then
      shift
    elif [[ "$web_mode" != "dev" ]]; then
      echo "error: unknown web mode: $web_mode" >&2
      usage >&2
      exit 2
    fi
    if [[ ! -x "$ROOT/web/node_modules/.bin/vite" ]]; then
      echo "error: web dependencies are missing. Run: cd $ROOT/web && npm install" >&2
      exit 2
    fi
    if [[ "$web_mode" == "start" ]]; then
      if [[ ! -f "$ROOT/web/dist/index.html" ]]; then
        echo "error: web build is missing. Run: cd $ROOT/web && npm run build" >&2
        exit 2
      fi
      exec npm --prefix "$ROOT/web" run start
    fi
    exec npm --prefix "$ROOT/web" run dev
    ;;
  --help|-h|help)
    usage
    ;;
  *)
    echo "error: unknown command: $command" >&2
    usage >&2
    exit 2
    ;;
esac
